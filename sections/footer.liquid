<footer class="site-footer" role="contentinfo">
  <div class="footer__newsletter">
    <h2 class="footer__title">{{ section.settings.newsletter_heading }}</h2>
    <p>{{ section.settings.newsletter_subtext }}</p>
    {%- form 'customer', id: 'FooterNewsletter', class: 'footer__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="FooterNewsletterEmail">{{ 'newsletter.label' | t }}</label>
      <input id="FooterNewsletterEmail" type="email" name="contact[email]" placeholder="Enter your email" required>
      <button type="submit">{{ section.settings.newsletter_button_label }}</button>
      {%- if form.posted_successfully? -%}
        <p class="footer__success">{{ 'newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="footer__error">{{ form.errors.messages['email'] }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>

  <div class="footer__grid">
    {%- for block in section.blocks -%}
      <div class="footer__block" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'links' -%}
            <h3 class="footer__title">{{ block.settings.heading }}</h3>
            {%- if block.settings.menu -%}
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- when 'social' -%}
            <h3 class="footer__title">{{ block.settings.heading }}</h3>
            <div class="footer__social">
              {%- if block.settings.facebook_link != blank -%}
                <a href="{{ block.settings.facebook_link }}" aria-label="Facebook">Facebook</a>
              {%- endif -%}
              {%- if block.settings.instagram_link != blank -%}
                <a href="{{ block.settings.instagram_link }}" aria-label="Instagram">Instagram</a>
              {%- endif -%}
              {%- if block.settings.twitter_link != blank -%}
                <a href="{{ block.settings.twitter_link }}" aria-label="X">X</a>
              {%- endif -%}
            </div>
          {%- when 'payment' -%}
            <h3 class="footer__title">{{ block.settings.heading }}</h3>
            <div class="footer__payment">
              {%- for type in shop.enabled_payment_types -%}
                {{ type | payment_type_svg_tag }}
              {%- endfor -%}
            </div>
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="footer__bottom">
    <small>© {{ 'now' | date: '%Y' }} {{ shop.name }}</small>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "newsletter_subtext",
      "label": "Newsletter subtext",
      "default": "Receive product news and curated content straight to your inbox."
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Newsletter button label",
      "default": "Subscribe"
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "social",
      "name": "Social links",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Connect"
        },
        { "type": "url", "id": "facebook_link", "label": "Facebook" },
        { "type": "url", "id": "instagram_link", "label": "Instagram" },
        { "type": "url", "id": "twitter_link", "label": "X (Twitter)" }
      ]
    },
    {
      "type": "payment",
      "name": "Payment icons",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Payments"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "links" },
        { "type": "links" },
        { "type": "social" },
        { "type": "payment" }
      ]
    }
  ]
}
{% endschema %}
